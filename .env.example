# ── Site ────────────────────────────────────────────────────────────────
# Base URL used for metadata, canonical URLs and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://aerocotton.in

# GitHub Pages RFQ fallback. The static site opens a prefilled email draft.
NEXT_PUBLIC_RFQ_EMAIL=enquiries@yourdomain.in

# ── RFQ enquiries (Resend transactional email) ──────────────────────────
# Without RESEND_API_KEY the server action logs enquiries instead of emailing —
# useful for local development. Get a key at https://resend.com
RESEND_API_KEY=
RFQ_TO_EMAIL=
RFQ_FROM_EMAIL="Aerocotton Website <enquiries@yourdomain.in>"

# ── Cloudflare Turnstile (optional spam protection) ─────────────────────
# The form renders a Turnstile widget only when the public key is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
