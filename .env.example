# ── Site ────────────────────────────────────────────────────────────────
# Base URL used for metadata, canonical URLs and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://aerocotton.in

# ── Enquiries & support (see README, “Enquiries, support and the mail endpoint”)
# Where the contact and support forms POST. The site ships its own endpoint at
# /api/submit.php, served by PHP; leave this blank unless the forms are hosted
# somewhere that cannot run PHP, in which case give the absolute URL of a host
# that can. Never put the destination inbox or a mailbox password here — those
# live in public/api/config.php on the server.
NEXT_PUBLIC_FORMS_ENDPOINT=

# Fallback address offered only when the endpoint cannot be reached at all —
# for instance on a static preview that cannot run PHP. It is public by design.
NEXT_PUBLIC_RFQ_EMAIL=enquiries@yourdomain.in

# ── Unused: the earlier Resend server-action pipeline ───────────────────
# Superseded by public/api/submit.php, which runs on the PHP host the site is
# actually deployed to. Kept for reference; nothing reads these any more.
RESEND_API_KEY=
RFQ_TO_EMAIL=
RFQ_FROM_EMAIL="Aerocotton Website <enquiries@yourdomain.in>"

# ── Cloudflare Turnstile (optional spam protection) ─────────────────────
# The forms render a Turnstile widget only when the public key is present, and
# the endpoint only verifies the token when the matching secret is set in
# public/api/config.php. Without both, the honeypot, timing check and rate
# limiter are what protect the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
