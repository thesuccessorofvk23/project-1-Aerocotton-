<?xml version="1.0" encoding="utf-8"?>
<!--
  BigRock / IIS (Plesk, Windows shared hosting) rules for this site.

  It travels with the build: `npm run build` copies public/ verbatim into out/,
  so out/web.config always lands right next to out/index.html.

  Deploy = upload the CONTENTS of out/ into httpdocs/. Then IIS will:
    - serve httpdocs/index.html for "/" (the booter) and for any folder that
      holds one — every page is a folder + index.html because the export uses
      trailingSlash, so /about/ resolves with no rewrite rules at all
    - answer any path that does not exist with the exported 404 page
    - hand out fonts, images, video and 3D models with the correct MIME types
-->
<configuration>
  <system.webServer>

    <!-- "/" and "/about/" find index.html inside the folder -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      Unknown path -> exported 404.html, still reported as 404.

      existingResponse="PassThrough" is load-bearing, not decoration. The
      default, "Replace", throws away the body of any response that carries an
      error status and substitutes IIS's own error page. That silently broke
      the enquiry endpoint: /api/submit.php answers with JSON — including for
      failures — and IIS was swapping that JSON for a stock error page (for a
      422, literally the words "The custom error module does not recognize this
      error."). The browser could not parse it, so every failure reached the
      visitor as the same meaningless "the enquiry service is not responding",
      no matter what had actually gone wrong.

      PassThrough leaves responses the application produced untouched, so the
      endpoint's own JSON and status code reach the form. IIS's *own* errors —
      a genuinely missing file — still get the branded page below, because
      those have no application response to preserve.

      responseMode="File" (not ExecuteURL) keeps the 404 status code while
      returning 404.html; ExecuteURL rewrites the status to 200, which would
      tell search engines every missing page is a working one.
    -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <!--
      Nothing under /api/ may be fetched except the two entry points.

      IIS ignores .htaccess completely, so on this host these rules are the only
      thing between a visitor and the endpoint's library, its credentials file,
      its rate-limit counters and submissions.log — which records every
      enquirer's name, email address, phone number and message.

      hiddenSegments rejects any request whose path contains the segment, so a
      nested or case-varied path is caught as well as the obvious one. None of
      these segments appears anywhere else in the export, so nothing the site
      serves is affected. Verified against the built tree before adding.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="config.php" />
          <add segment="config.example.php" />
          <add segment="config.local.example.php" />
          <add segment="config.production.example.php" />
          <add segment="aero-config.php" />
        </hiddenSegments>
        <!--
          .log has no MIME map, so IIS answers 404 for it today — but that is a
          side effect of a missing mapping, not a rule, and it would end the
          moment somebody added one. This makes the refusal deliberate. No .log
          file is part of the export.
        -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Remove-then-add: safe whether or not IIS already maps the extension -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".obj" />
      <mimeMap fileExtension=".obj" mimeType="text/plain" />
    </staticContent>

  </system.webServer>
</configuration>
